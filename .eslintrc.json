{
  "env": {
    "es6": true,
    "node": true,
    "jest": true
  },
  "parserOptions": {
    "parser": "@typescript-eslint/parser",
    "ecmaVersion": 2018,
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint",
    "prettier"
  ],
  "extends": [
    "plugin:@typescript-eslint/recommended",
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "prettier"
  ],
  "rules": {
    "prettier/prettier": 2, // Means error
    "@typescript-eslint/no-explicit-any": "off",
    // ESLint's own no-unused-vars doesn't understand TypeScript (it flags enum members and type
    // parameters) and doubles every report. The TypeScript version below replaces it.
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": "error",
    // typescript-eslint 8 replaced no-empty-interface with no-empty-object-type. Empty interfaces
    // are still allowed (Feathers extends them through declaration merging); empty {} types are not.
    "@typescript-eslint/no-empty-object-type": ["error", { "allowInterfaces": "always" }]
  }
}
